{
	admin 0.0.0.0:2019

	metrics {
		per_host
	}

	crowdsec {
		api_url http://crowdsec:8080
		api_key {$CADDY_CS_KEY}
	}
}

(authentik) {
	reverse_proxy /outpost.goauthentik.io/* http://authentik:9000
	forward_auth {args.0} http://authentik:9000 {
		uri /outpost.goauthentik.io/auth/caddy
		copy_headers X-Authentik-Username X-Authentik-Groups X-Authentik-Email X-Authentik-Name X-Authentik-Uid X-Authentik-Jwt X-Authentik-Meta-Jwks X-Authentik-Meta-Outpost X-Authentik-Meta-Provider X-Authentik-Meta-App X-Authentik-Meta-Version
		trusted_proxies private_ranges
	}
}

(anubis) {
	reverse_proxy http://anubis:8923 {
		header_up X-Real-Ip {remote_host}
		header_up X-Http-Version {http.request.proto}
	}
}

korhonen.cc, *.korhonen.cc {
	encode zstd gzip

	tls {
		dns cloudflare {$CF_API_TOKEN}
		resolvers 1.1.1.1
	}

	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
	}

	@static {
		file
		path *.ico *.css *.js *.gif *.webp *.avif *.jpg *.jpeg *.png *.svg *.woff *.woff2 *.pdf *.webmanifest
	}

	@homepage-www-redir host www.korhonen.cc
	handle @homepage-www-redir {
		redir https://korhonen.cc
	}

	@homepage host korhonen.cc
	handle @homepage {
		# Redirect finnish WIP
		# @redirFinnish {
		#     header Accept-Language *fi-FI*
		#     not path *.js *.css *.png *.jpg *.jpeg *.svg
		#     not path /en* /fi*
		#   }
		#   redir @redirFinnish /fi{uri}
		#
		#   uri strip_prefix /en

		header @static Cache-Control max-age=5184000
		root * /var/www/korhonen.cc
		file_server
	}

	@wkd host openpgpkey.korhonen.cc
	handle @wkd {
		root * /var/www/wkd
		header Access-Control-Allow-Origin "*"
		file_server {
			browse /templates/file_server.html
		}
	}

	@index host index.korhonen.cc
	handle @index {
		import anubis
	}

	@home-assistant host home.korhonen.cc
	handle @home-assistant {
		reverse_proxy home-assistant:8123
	}

	@authentik host sso.korhonen.cc
	handle @authentik {
		route /* {
			sablier http://sablier:10000 {
				group authentik
				session_duration 5m
				dynamic {
					display_name Korhonen SSO
					theme ghost
					show_details true
				}
			}
		}

		reverse_proxy authentik:9000
	}

	@forgejo host git.korhonen.cc
	handle @forgejo {
		import anubis
	}

	@woodpecker host ci.korhonen.cc
	handle @woodpecker {
		reverse_proxy woodpecker:8000
	}

	@searxng host dsearch.korhonen.cc
	handle @searxng {
		reverse_proxy searxng:8080
	}

	@miniflux host rss.korhonen.cc
	handle @miniflux {
		reverse_proxy miniflux:8080
	}

	@jellyfin host jellyfin.korhonen.cc
	handle @jellyfin {
		route /* {
			sablier http://sablier:10000 {
				group jellyfin
				session_duration 30m
				dynamic {
					display_name Jellyfin
					theme ghost
					show_details true
				}
			}
		}

		reverse_proxy jellyfin:8096
	}

	@pihole host pihole.korhonen.cc
	handle @pihole {
		reverse_proxy pihole
	}

	@umami host umami.korhonen.cc
	handle @umami {
		reverse_proxy umami:3000
	}

	@nextcloud host cloud.korhonen.cc
	handle @nextcloud {
		# Redirect login page to Authentik
		redir /login /apps/sociallogin/custom_oidc/korhonen-sso 301

		# .htaccess / data / config / ... shouldn't be accessible from outside
		@forbidden {
			path /.htaccess
			path /data/*
			path /config/*
			path /db_structure
			path /.xml
			path /README
			path /3rdparty/*
			path /lib/*
			path /templates/*
			path /occ
			path /console.php
		}
		handle @forbidden {
			respond 404
		}

		redir /.well-known/carddav /remote.php/dav 301
		redir /.well-known/caldav /remote.php/dav 301

		root * /var/www/nextcloud
		php_fastcgi nextcloud:9000 {
			root /var/www/html
			# Tells nextcloud to remove /index.php from URLs in links
			env front_controller_active true
		}
		file_server
	}

	# @collabora host collabora.korhonen.cc
	# handle @collabora {
	# 	reverse_proxy collabora:9980
	# }

	@drop host drop.korhonen.cc
	handle @drop {
		reverse_proxy drop:3000
	}

	@ipvX host ipv6.korhonen.cc ipv4.korhonen.cc
	handle @ipvX {
		respond {remote_host}
	}

	@lubelogger host lubelogger.korhonen.cc
	handle @lubelogger {
		import anubis
	}

	@mosquitto host mqtt.korhonen.cc
	handle @mosquitto {
		@websockets {
			header Connection *Upgrade*
			header Upgrade websocket
		}
		reverse_proxy @websockets mosquitto:9001
	}

	handle {
		respond "404 Not Found" 404
	}

	@tvheadend host tv.korhonen.cc
	handle @tvheadend {
		import authentik
		reverse_proxy tvheadend:9981
	}

	@grafana host graph.korhonen.cc
	handle @grafana {
		reverse_proxy grafana:3000
	}

	handle_errors {
		@homepage_404 {
			expression {http.error.status_code} == 404
			host korhonen.cc
		}
		handle @homepage_404 {
			root * /var/www/korhonen.cc
			rewrite * /404.html
			file_server
		}

		respond "{err.status_code} {err.status_text}"
	}
}

# Internal handler for traffic that has passed the Anubis challenge
:3001 {
	@forgejo host git.korhonen.cc
	handle @forgejo {
		rewrite /user/login /user/oauth2/Korhonen%20SSO
		reverse_proxy forgejo:3000
	}

	@lubelogger host lubelogger.korhonen.cc
	handle @lubelogger {
		route /* {
			sablier http://sablier:10000 {
				group lubelogger
				session_duration 5m
				dynamic {
					display_name Lubelogger
					theme ghost
					show_details true
				}
			}
		}

		reverse_proxy lubelogger:8080
	}

	@index host index.korhonen.cc
	handle @index {
		root * /var/www/index.korhonen.cc
		file_server {
			browse /templates/file_server.html
		}
	}
}

http://moria.korhonen.lan {
	redir /pacman_cache /pacman_cache/ 308

	handle_path /pacman_cache/* {
		root * /var/cache/pacman/pkg
		file_server browse
	}
}
