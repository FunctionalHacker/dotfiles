#!/bin/sh

set -e

CONTROLLER_HANDLER_PID=""
DEVICE="/dev/input/js0"

# Start controller input handler
start_handler() {
  jstest --event /dev/input/js0 2>/dev/null | while IFS= read -r line; do
    # D-pad up
    if echo "$line" | grep -qE "type 2.*number 7.*value -32767"; then
      ydotool key 103:1 103:0

    # D-pad down
    elif echo "$line" | grep -qE "type 2.*number 7.*value 32767"; then
      ydotool key 108:1 108:0

    # A button
    elif echo "$line" | grep -qE "type 1.*number 0.*value 1"; then
      ydotool key 28:1 28:0

    # B button (usually BTN_SOUTH)
    elif echo "$line" | grep -q "BTN_SOUTH"; then
      ydotool key 1:1 1:0
    fi
  done &
} 2>/dev/null

# Monitor for controller connection and start handler if needed
monitor_controller() {
  while true; do
    if [ -e "$DEVICE" ] && [ -z "$CONTROLLER_HANDLER_PID" ]; then
      CONTROLLER_HANDLER_PID=$(start_handler)
    elif [ ! -e "$DEVICE" ] && [ -n "$CONTROLLER_HANDLER_PID" ]; then
      kill "$CONTROLLER_HANDLER_PID" 2>/dev/null
      wait "$CONTROLLER_HANDLER_PID" 2>/dev/null
      CONTROLLER_HANDLER_PID=""
    fi
    sleep 0.5
  done
}

# Start controller monitor in background
monitor_controller &
CONTROLLER_MONITOR_PID=$!

gui() {
  kmscon-launch-gui "$@"
  clear
}

cage() {
  gui /usr/bin/cage "$1"
}

headless_discord() {
  systemctl --user "$1" headless-discord
}

while :; do
  CHOICE=$(dialog \
    --clear \
    --stdout \
    --no-ok \
    --no-cancel \
    --title "FunctionalHacker CRT Menu" \
    --menu "Select an action" \
    80 80 10 \
    1 "Kodi" \
    2 "RetroArch" \
    3 "Steam" \
    4 "Terminal" \
    5 "NeoVim" \
    6 "Firefox" \
    7 "Reboot" \
    8 "Power off")

  RET=$?

  [ "$RET" -ne 0 ] && exit 0

  case "$CHOICE" in
  1)
    headless_discord start
    gui kodi
    headless_discord stop
    ;;
  2)
    headless_discord start
    gui retroarch
    headless_discord stop
    ;;
  3)
    headless_discord start
    gui gamescope -W 640 -H 480 -- steam -gamepadui -steamos3
    headless_discord stop
    ;;
  4)
    clear
    $SHELL
    ;;
  5)
    nvim
    ;;
  6)
    cage firefox
    ;;
  7)
    reboot
    ;;
  8)
    systemctl poweroff
    ;;
  esac
  setterm --reset
done

# Kill monitor and handler
kill "$CONTROLLER_MONITOR_PID" 2>/dev/null
if [ -n "$CONTROLLER_HANDLER_PID" ]; then
  kill "$CONTROLLER_HANDLER_PID" 2>/dev/null
fi
wait 2>/dev/null
